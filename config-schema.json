  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "JSON Schema for validating config.toml, config.default.toml, and config.NAME.toml files. Properties are all optional since overlay files only carry the keys they override; the base config.toml provides the rest.",
